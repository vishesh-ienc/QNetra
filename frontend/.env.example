# QNetra frontend configuration
#
# VITE_API_MODE
#   live — talk to the QNetra FastAPI gateway (backend/, Phase 4).
#   mock — serve the offline dataset in src/mocks/fixtures, produced by running
#          the real QNetra pipeline over samples/. This is the default because
#          the API gateway is not implemented yet.
VITE_API_MODE=mock

# Base URL of the API when VITE_API_MODE=live.
VITE_API_BASE_URL=/api/v1

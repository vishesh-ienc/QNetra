# QNetra frontend configuration
#
# VITE_API_MODE
#   live (default) — talk to the QNetra FastAPI gateway (backend/).
#         Start it with: uvicorn backend.main:app --reload --port 8000
#   mock — serve the offline dataset in src/mocks/fixtures, produced by running
#         the real QNetra pipeline over samples/. Useful for UI work without a
#         running backend.
VITE_API_MODE=live

# Base URL of the API. Left relative so the Vite dev server proxy (vite.config.ts)
# forwards it to the backend — avoids CORS entirely in dev.
VITE_API_BASE_URL=/api/v1
